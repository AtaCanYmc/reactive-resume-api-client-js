{
  "name": "reactive-resume-api-client-js",
  "version": "1.0.0",
  "description": "Unofficial TypeScript/JavaScript API client (SDK) for Reactive Resume v4",
  "author": "Ata Can Yaymacı",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtaCanYmc/reactive-resume-api-client-js.git"
  },
  "bugs": {
    "url": "https://github.com/AtaCanYmc/reactive-resume-api-client-js/issues"
  },
  "homepage": "https://github.com/AtaCanYmc/reactive-resume-api-client-js#readme",
  "keywords": [
    "reactive-resume",
    "rxresume",
    "resume",
    "cv",
    "api-client",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:demo": "npm run build && mkdir -p demo/web/vendor && cp dist/index.js demo/web/vendor/reactive-resume-api-client.js",
    "preview:demo": "npm run build:demo && node demo/web/server.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
